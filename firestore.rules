rules_version = '2';

// AlkanSave access model
//   households/{hid}             a family book; only its members can see it
//   households/{hid}/members/{uid}  role: owner | editor | viewer
//   households/{hid}/tx/{id}     entries; owners and editors write
//   households/{hid}/config/budgets  monthly limits
//   households/{hid}/config/shared   starting balances of the shared Cash and credit card
//   households/{hid}/config/accounts older shared list of starting balances
//   households/{hid}/recurring/{id}  bills/income added automatically each month
//   households/{hid}/members/{uid}/devices/{id}  phones that get bill reminders
//   invites/{code}               join links an owner creates; valid until expiresAt
//   users/{uid}                  which household a person last opened (private to them)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function memberPath(hid) { return /databases/$(database)/documents/households/$(hid)/members/$(me()); }
    function isMember(hid) { return signedIn() && exists(memberPath(hid)); }
    function roleIn(hid, roles) { return isMember(hid) && get(memberPath(hid)).data.role in roles; }
    function canWrite(hid) { return roleIn(hid, ['owner', 'editor']); }
    function isOwner(hid) { return roleIn(hid, ['owner']); }

    function shortStr(v, max) { return v is string && v.size() <= max; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    function validProfile(d) {
      return shortStr(d.name, 60) && shortStr(d.color, 20) && shortStr(d.avatarUrl, 500);
    }

    function validInvite(hid, code) {
      let path = /databases/$(database)/documents/invites/$(code);
      return code is string && exists(path)
        && get(path).data.hid == hid
        && get(path).data.expiresAt > request.time;
    }

    function validTx(d) {
      return d.keys().hasOnly(['type', 'amountCents', 'date', 'cat', 'acct', 'to', 'note', 'by', 'createdAt', 'updatedAt', 'updatedBy', 'rec'])
        && (d.get('rec', null) == null || shortStr(d.rec, 60))
        && d.keys().hasAll(['type', 'amountCents', 'date', 'cat', 'acct', 'by', 'createdAt'])
        && d.type in ['expense', 'income', 'transfer']
        && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 100000000000
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && shortStr(d.cat, 30) && shortStr(d.acct, 30)
        && (d.get('to', null) == null || shortStr(d.to, 30))
        && shortStr(d.get('note', ''), 200)
        && d.by is string
        && d.createdAt is int
        && d.get('updatedAt', 0) is int
        && (d.get('updatedBy', null) == null || d.updatedBy is string)
        && (d.type == 'transfer') == (d.get('to', null) != null);
    }

    function validRecurring(d) {
      let fields = ['type', 'amountCents', 'cat', 'acct', 'note', 'day', 'lastPosted', 'active', 'createdBy', 'createdAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.type in ['expense', 'income']
        && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 100000000000
        && shortStr(d.cat, 30) && shortStr(d.acct, 30) && shortStr(d.note, 200)
        && d.day is int && d.day >= 1 && d.day <= 31
        && d.lastPosted is string && d.lastPosted.matches('^[0-9]{4}-[0-9]{2}$')
        && d.active is bool
        && d.createdBy is string && d.createdAt is int;
    }

    // A recurring bill is posted by whichever family phone opens the app first that month,
    // but it's credited to the person who set the bill up.
    function postedForRecurring(hid, d) {
      let path = /databases/$(database)/documents/households/$(hid)/recurring/$(d.get('rec', '-'));
      return d.get('rec', null) is string && exists(path) && get(path).data.createdBy == d.by;
    }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['householdId', 'updatedAt'])
        && shortStr(request.resource.data.householdId, 40);
    }

    match /invites/{code} {
      // Readable by anyone signed in who has the code; never listable.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.size() >= 12
        && isOwner(request.resource.data.hid)
        && request.resource.data.keys().hasOnly(['hid', 'householdName', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.createdBy == me()
        && shortStr(request.resource.data.householdName, 60)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');
      allow delete: if isOwner(resource.data.hid);
      allow update: if false;
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && request.resource.data.ownerId == me()
        && shortStr(request.resource.data.name, 60)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(hid) && changedOnly(['name']) && shortStr(request.resource.data.name, 60);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(hid);

        // Join as owner right after creating the household, or as editor with a valid invite.
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['role', 'name', 'color', 'avatarUrl', 'joinedAt', 'inviteCode'])
          && validProfile(request.resource.data)
          && request.resource.data.joinedAt == request.time
          && (
            (request.resource.data.role == 'owner'
              && getAfter(/databases/$(database)/documents/households/$(hid)).data.ownerId == me())
            || (request.resource.data.role == 'editor'
              && validInvite(hid, request.resource.data.inviteCode))
          );

        // Members edit their own name/color/photo and their own starting balances ("start": account → amount);
        // the owner changes other people's roles.
        allow update: if (uid == me() && isMember(hid) && changedOnly(['name', 'color', 'avatarUrl', 'start'])
            && validProfile(request.resource.data)
            && (!('start' in request.resource.data) || (request.resource.data.start is map && request.resource.data.start.size() <= 20)))
          || (isOwner(hid) && uid != me() && changedOnly(['role']) && request.resource.data.role in ['editor', 'viewer']);

        // Leave the household (not the owner), or the owner removes someone else.
        allow delete: if (uid == me() && isMember(hid) && resource.data.role != 'owner')
          || (isOwner(hid) && uid != me());

        // Phones that get bill reminders. Only the person themselves can see or change theirs;
        // the daily reminder job (api/reminders.js) reads them with admin access.
        match /devices/{deviceId} {
          allow read, delete: if signedIn() && uid == me() && isMember(hid);
          allow create, update: if signedIn() && uid == me() && isMember(hid)
            && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
            && shortStr(request.resource.data.token, 4096) && request.resource.data.token.size() > 0
            && shortStr(request.resource.data.platform, 40)
            && request.resource.data.updatedAt is int;
        }
      }

      match /tx/{id} {
        allow read: if isMember(hid);
        allow create: if canWrite(hid) && validTx(request.resource.data)
          && (request.resource.data.by == me() || postedForRecurring(hid, request.resource.data));
        allow update: if canWrite(hid) && validTx(request.resource.data)
          && request.resource.data.by == resource.data.by
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == me();
        allow delete: if canWrite(hid);
      }

      match /recurring/{id} {
        allow read: if isMember(hid);
        allow create: if canWrite(hid) && validRecurring(request.resource.data)
          && request.resource.data.createdBy == me();
        allow update: if canWrite(hid) && validRecurring(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canWrite(hid);
      }

      match /config/{doc} {
        allow read: if isMember(hid);
        allow write: if canWrite(hid)
          && request.resource.data.updatedBy == me()
          && (
            (doc == 'budgets'
              && request.resource.data.keys().hasOnly(['limits', 'updatedAt', 'updatedBy'])
              && request.resource.data.limits is map
              && request.resource.data.limits.size() <= 40)
            // 'shared': starting balances of the family's shared Cash and credit card;
            // 'accounts': the older, single list of starting balances (still read for anything not yet moved).
            || (doc in ['accounts', 'shared']
              && request.resource.data.keys().hasOnly(['start', 'updatedAt', 'updatedBy'])
              && request.resource.data.start is map
              && request.resource.data.start.size() <= 20)
          );
      }
    }
  }
}
