# Firebase web app config. Copy to .env.local for local dev,
# and add the same names as Environment Variables in the Vercel project.
# These values are public by design; Firestore security rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Bill reminders (optional; the reminders card stays hidden without these).
# Sender id: firebaseConfig.messagingSenderId. Web Push key: Firebase → Project settings →
# Cloud Messaging → Web Push certificates → Key pair.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Server only (Vercel, Production). Never prefix these with VITE_, or they'd be built into the app.
# FIREBASE_SERVICE_ACCOUNT  whole JSON of a key from Firebase → Project settings → Service accounts
# CRON_SECRET               any long random string; Vercel Cron sends it to /api/reminders
