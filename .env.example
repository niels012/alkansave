# Firebase web app config (Phase 2). Copy to .env.local for local dev,
# and add the same names as Environment Variables in the Vercel project.
# These values are public by design; Firestore security rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
